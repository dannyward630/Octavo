{
  "name": "octavo",
  "productName": "Octavo",
  "version": "0.1.0",
  "description": "An EPUB and PDF reader with a cover gallery, highlights, bookmarks and Obsidian export.",
  "main": "./out/main/index.js",
  "license": "GPL-3.0-or-later",
  "author": "Andrew McKenzie",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.js",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-pdfjs-assets.js",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.scripts.json --composite false",
    "test": "tsx --test scripts/*.test.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "smoke": "npm run build && npm run fixtures && tsx scripts/smoke.ts",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "electron:fetch": "node node_modules/electron/install.js",
    "icons": "node scripts/make-icons.js",
    "licenses": "node scripts/third-party-licenses.js",
    "changelog": "git-cliff -o CHANGELOG.md",
    "version:next": "git-cliff --bumped-version",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.2",
    "foliate-js": "^1.0.1",
    "git-cliff": "^2.14.2",
    "lucide-react": "^1.58.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.56.0",
    "png2icons": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
